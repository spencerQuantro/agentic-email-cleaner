#!/usr/bin/env python3
"""Serve factory/dashboard.html on localhost and open it in a browser.

Usage:
  dashboard                 start the server if it isn't running, then open the board
  dashboard --port <n>      prefer port n (default 8000; the next free port if taken)
  dashboard --no-open       start or find the server, print the URL, don't open a browser
  dashboard --stop          stop the server
  dashboard --status        print the URL if the server is running

The server is `python3 -m http.server` run from factory/, bound to 127.0.0.1
only, detached from this shell so it outlives the command. Its pid and port are
kept in factory/jobs/.dashboard.json (gitignored runtime state).
"""

import json
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.request
import webbrowser
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
JOBS = FACTORY / "jobs"
STATE = JOBS / ".dashboard.json"
LOG = JOBS / ".dashboard.log"
HOST = "127.0.0.1"
DEFAULT_PORT = 8000


def die(msg):
    print(f"dashboard: {msg}", file=sys.stderr)
    sys.exit(1)


def url(port):
    return f"http://{HOST}:{port}/dashboard.html"


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind((HOST, port))
            return True
        except OSError:
            return False


def serves_this_factory(port):
    """True when the server on `port` is serving this factory's dashboard."""
    try:
        with urllib.request.urlopen(url(port), timeout=1) as res:
            return res.status == 200 and b"factory/bin/job" in res.read()
    except OSError:
        return False


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def running():
    """The recorded server, if it's still up and still ours."""
    if not STATE.exists():
        return None
    try:
        state = json.loads(STATE.read_text())
    except ValueError:
        return None
    if alive(state.get("pid")) and serves_this_factory(state.get("port")):
        return state
    STATE.unlink(missing_ok=True)
    return None


def start(preferred):
    port = next((p for p in range(preferred, preferred + 100) if port_free(p)), None)
    if port is None:
        die(f"no free port in {preferred}-{preferred + 99}")
    JOBS.mkdir(exist_ok=True)
    with open(LOG, "ab") as log:
        proc = subprocess.Popen(
            [sys.executable, "-m", "http.server", str(port), "--bind", HOST, "--directory", str(FACTORY)],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
        )
    for _ in range(50):
        if proc.poll() is not None:
            die(f"the server exited with code {proc.returncode}; see {LOG}")
        if serves_this_factory(port):
            break
        time.sleep(0.1)
    else:
        proc.terminate()
        die(f"the server didn't answer on port {port}; see {LOG}")
    state = {"pid": proc.pid, "port": port}
    STATE.write_text(json.dumps(state) + "\n")
    return state


def stop():
    state = running()
    if not state:
        STATE.unlink(missing_ok=True)
        print("dashboard: not running")
        return
    os.killpg(state["pid"], signal.SIGTERM)
    STATE.unlink(missing_ok=True)
    print(f"dashboard: stopped (port {state['port']})")


def main(argv):
    args = list(argv)
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return
    if args == ["--stop"]:
        return stop()
    if args == ["--status"]:
        state = running()
        print(url(state["port"]) if state else "dashboard: not running")
        sys.exit(0 if state else 1)

    open_browser = "--no-open" not in args
    args = [a for a in args if a != "--no-open"]
    preferred = DEFAULT_PORT
    if args[:1] == ["--port"] and len(args) == 2 and args[1].isdigit():
        preferred = int(args[1])
        args = []
    if args:
        die(f"bad arguments: {' '.join(argv)}\n\n{__doc__.strip()}")

    state = running()
    if state:
        print(f"dashboard: already running at {url(state['port'])}")
    else:
        state = start(preferred)
        print(f"dashboard: serving {FACTORY} at {url(state['port'])} (stop with factory/bin/dashboard --stop)")
    if open_browser and not webbrowser.open(url(state["port"])):
        print("dashboard: couldn't open a browser; open the URL above")


if __name__ == "__main__":
    main(sys.argv[1:])
