# Copy to .env and fill in. Never commit .env.

# Run against bundled fixtures instead of a real Gmail account (1 = on)
SWEEP_DEMO=1

# Server
PORT=8787
DATABASE_URL=./data/sweep.db
WEB_ORIGIN=http://localhost:5173

# Encrypts the stored Google refresh token. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google OAuth client (create your own in Google Cloud Console, keep it in "Testing" mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Anthropic API key (used only for senders the rule-based checks can't decide)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Timezone for the daily/weekly run schedule (runs at 6:00 AM local time)
TZ=America/Denver
